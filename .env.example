# Copy to .env and fill in. Next.js loads .env automatically in dev and build.

# --- required in production ---
# Session cookie signing secret. Generate: openssl rand -base64 48
SESSION_SECRET=change-me

# --- optional ---
# SQLite database location. Defaults to prisma/dev.db when unset.
# DATABASE_URL=file:/var/lib/puzzlehub/prod.db

# Telegram Mini Apps sign-in. Token from @BotFather ("API token" of the SAME
# bot whose Mini App URL points to this site). Without it /api/auth/telegram
# returns 503 telegram_disabled and users keep playing as guests.
# TELEGRAM_BOT_TOKEN=123456789:AAF...your-token...

# Admin dashboard at /{locale}/admin and /api/admin/stats.
# Generate: openssl rand -hex 24. Without it the dashboard is disabled (404).
# ADMIN_KEY=change-me-too
